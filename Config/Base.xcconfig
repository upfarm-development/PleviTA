// Shared build settings for both PleviTA targets.

// One bundle id for both targets, so iOS and tvOS are a single App Store Connect app with two platforms rather than two separate apps.
PLEVI_BUNDLE_ID = com.plevi.ta

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 202

// iOS 18+: raised from 17 specifically to use `Tab(role: .search)` in the iPhone tab bar.
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TVOS_DEPLOYMENT_TARGET = 17.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Code signing for physical-device builds.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

TA_DEV_SERVER_URL =
TA_DEV_TOKEN =

// Local.xcconfig is optional and gitignored; #include? tolerates its
// absence so a fresh checkout still builds without it. Kept last so any
// values it sets override the empty defaults above.
#include? "Local.xcconfig"
