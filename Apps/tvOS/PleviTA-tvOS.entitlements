<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.plevi.ta.shared</string>
	</array>
	<!-- iCloud's key-value store — see Apps/iOS/PleviTA.entitlements for the full
	     reasoning. Resolves to the same identifier as the iOS app because both
	     ship the same bundle id, which is what keeps the Apple TV and the iPhone
	     looking at one shared "recently played" history. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.plevi.ta</string>
	</array>
</dict>
</plist>
